# ═══════════════════════════════════════════════════════════════
# HERMES Global Platform - Environment Variables
# ═══════════════════════════════════════════════════════════════

# NODE ENVIRONMENT
NODE_ENV=production
NODE_LOG_LEVEL=info

# FRONTEND
FRONTEND_URL=https://hermes-platform.com
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://api.hermes-platform.com

# BACKEND
BACKEND_URL=https://api.hermes-platform.com
BACKEND_PORT=3001
BACKEND_SECRET_KEY=generate_strong_secret_key_here

# DATABASE (PostgreSQL - Multi-Region)
DATABASE_URL=postgresql://user:pass@db-primary.hermes.internal:5432/hermes_prod
DATABASE_REPLICA_URL=postgresql://user:pass@db-replica.hermes.internal:5432/hermes_prod
DATABASE_HOST=db-primary.hermes.internal
DATABASE_PORT=5432
DATABASE_NAME=hermes_prod
DATABASE_USER=hermes_user
DATABASE_PASSWORD=secure_password
DATABASE_SSL=true
DATABASE_POOL_SIZE=20
DATABASE_IDLE_TIMEOUT=30000

# REDIS (Distributed Cluster)
REDIS_CLUSTER_NODES=redis-1.hermes.internal:6379,redis-2.hermes.internal:6379,redis-3.hermes.internal:6379
REDIS_PASSWORD=redis_secure_password
REDIS_DB=0
REDIS_KEY_PREFIX=hermes:

# MESSAGE QUEUE (RabbitMQ)
RABBITMQ_URL=amqp://user:pass@rabbitmq.hermes.internal:5672
RABBITMQ_PREFETCH=10

# ELASTICSEARCH (Search & Logging)
ELASTICSEARCH_NODES=elasticsearch-1.hermes.internal:9200,elasticsearch-2.hermes.internal:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elastic_password
ELASTICSEARCH_INDEX_PREFIX=hermes-

# JWT & AUTH
JWT_SECRET=super_secret_jwt_key_256_bits_minimum
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_GITHUB_CLIENT_ID=your_github_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret

# EXTERNAL APIs
FOOTBALL_DATA_API_KEY=your_api_key
UNDERSTAT_API_KEY=your_api_key
WHOSCORED_API_KEY=your_api_key
FLASHSCORE_API_KEY=your_api_key

# STRIPE PAYMENTS
STRIPE_PUBLIC_KEY=pk_live_your_key
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# EMAIL SERVICE (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@hermes-platform.com

# SMS SERVICE (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# PUSH NOTIFICATIONS
FCM_SERVER_KEY=your_firebase_server_key
APNS_CERTIFICATE=your_apple_push_certificate

# MONITORING & LOGGING
SENTRY_DSN=https://key@sentry.io/project_id
SENTRY_ENVIRONMENT=production
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# PROMETHEUS & GRAFANA
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=strong_password
GRAFANA_DOMAIN=grafana.hermes-platform.com

# n8n AUTOMATION
N8N_BASE_URL=https://automation.hermes-platform.com
N8N_API_KEY=your_n8n_api_key
N8N_WEBHOOK_URL=https://api.hermes-platform.com/webhooks/n8n

# S3 / OBJECT STORAGE
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=hermes-platform-uploads
S3_PUBLIC_URL=https://cdn.hermes-platform.com

# CDN & CACHING
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CDN_CACHE_MAX_AGE=86400

# FEATURE FLAGS
FEATURE_RED_TEAM_ANALYSIS=true
FEATURE_CONTRARIAN_ANALYSIS=true
FEATURE_SENSITIVITY_ANALYSIS=true
FEATURE_LIVE_ALERTS=true
FEATURE_SOCIAL_FEATURES=true
FEATURE_PAYMENT_INTEGRATION=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_AI_COPILOT=false
FEATURE_LIVE_STREAMING=false

# QUALITY THRESHOLDS
QUALITY_MIN_SCORE_FOR_PREDICTION=70
QUALITY_MIN_SOURCES=2
CONFIDENCE_MIN_FOR_BET=0.65
QUALITY_CACHE_TTL=3600

# MODEL CONFIG
MODEL_ENSEMBLE_STRATEGY=weighted_average
MODEL_UNCERTAINTY_THRESHOLD=0.30
MODEL_AUTO_CALIBRATION=true
MODEL_RETRAIN_SCHEDULE=weekly

# RATE LIMITING
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_STRICT_MODE=false

# LOCALIZATION
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,fa,ar,zh,es,pt,ru,ja
DEFAULT_TIMEZONE=UTC
LOCAL_TIMEZONE=Asia/Tehran

# KUBERNETES
KUBERNETES_NAMESPACE=hermes-prod
KUBERNETES_SERVICE_ACCOUNT=hermes-app

# PERFORMANCE
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
ENABLE_CDN=true
WORKER_THREADS=4

# SECURITY
ENABLE_RATE_LIMITING=true
ENABLE_DDOS_PROTECTION=true
ENABLE_2FA=true
ENABLE_API_KEY_AUTH=true
CORS_ALLOWED_ORIGINS=https://hermes-platform.com,https://www.hermes-platform.com,https://app.hermes-platform.com
